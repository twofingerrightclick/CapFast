<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == ''">$(MSBuildProjectDirectory)/../../artifacts/packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Core/EnglishCaptionBlacklist.txt" LogicalName="CapFast.EnglishCaptionBlacklist.txt" />
    <Content Include="../../third_party/caption-blacklist/**/*"
             Link="third_party/caption-blacklist/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>
</Project>
